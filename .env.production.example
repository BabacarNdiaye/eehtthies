# =============================================================================
# EEHT de Thiès — configuration de PRODUCTION (hébergement mutualisé cPanel)
# =============================================================================
# Sur le serveur : copiez ce fichier en `.env` à la racine de l'application,
# remplissez chaque valeur marquée « À REMPLIR », puis lancez
# `php artisan key:generate --force`. Voir DEPLOIEMENT.md.
# Ne commitez JAMAIS le `.env` rempli.
# =============================================================================
APP_NAME="EEHT de Thiès"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
# À REMPLIR : l'adresse publique exacte, en https
APP_URL=https://www.eeht-thies.sn

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# À REMPLIR : base MySQL créée dans cPanel › Bases de données MySQL
# (cPanel préfixe le nom de la base et de l'utilisateur par votre identifiant)
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# À REMPLIR : identifiants SMTP Brevo (ou fournisseur de l'hébergeur)
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@eeht-thies.sn"
MAIL_FROM_NAME="${APP_NAME}"

# Destinataire des alertes de sauvegarde (échec, anomalie détectée).
BACKUP_NOTIFY_EMAIL=admin@eeht-thies.sn
# Décommentez pour chiffrer les archives de sauvegarde (gardez ce mot de
# passe en lieu sûr : sans lui, les sauvegardes ne peuvent plus être ouvertes).
# BACKUP_ARCHIVE_PASSWORD=

# Notifications push (navigateur). Générées une fois en local via
# `php artisan webpush:vapid` — copiez les mêmes clés ici, ne les régénérez
# jamais en production (ça invaliderait les abonnements déjà enregistrés).
VAPID_SUBJECT=mailto:admin@eeht-thies.sn
# À REMPLIR : reprendre les clés du poste local, ne pas les régénérer
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Jeton partagé par la tablette/borne de pointage à l'entrée
# (/borne/pointage/open?token=...&mode=gate). Générez une valeur aléatoire
# longue (ex : `php artisan tinker --execute="echo Str::random(32);"`).
# À REMPLIR
KIOSK_TOKEN=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Assistant IA d'EEHT Connect (suggestions de réponses, résumés, correction,
# traduction). Laissez vide pour désactiver l'assistant. Clé à créer sur
# https://platform.claude.com (facturation à l'usage). Les extraits de
# conversation envoyés à l'assistant sont transmis à Anthropic.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_EFFORT=low

# Appels audio/vidéo EEHT Connect : relais TURN facultatif (améliore les
# appels entre réseaux mobiles / pare-feux stricts). Sans TURN, les appels
# passent en direct quand les réseaux le permettent.
# TURN_URL=turn:turn.exemple.sn:3478
# TURN_USERNAME=
# TURN_CREDENTIAL=

VITE_APP_NAME="${APP_NAME}"
