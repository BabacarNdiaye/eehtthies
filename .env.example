APP_NAME="EEHT de Thiès"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Base de données locale (SQLite). Pour MySQL : DB_CONNECTION=mysql + DB_HOST/DB_PORT/DB_DATABASE/DB_USERNAME/DB_PASSWORD
DB_CONNECTION=sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@eeht-thies.sn"
MAIL_FROM_NAME="${APP_NAME}"
BACKUP_NOTIFY_EMAIL=admin@eeht-thies.sn

# Notifications push (générer avec : php artisan webpush:vapid) — À REMPLIR
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Borne de pointage : longue valeur aléatoire — À REMPLIR
KIOSK_TOKEN=

# Assistant IA (facultatif, masqué si vide)
ANTHROPIC_API_KEY=

# Paiements en ligne : none par défaut
PAYMENTS_DRIVER=none
PAYMENTS_ALLOW_SIMULATION=false

# Visioconférence / TURN (facultatif)
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=
