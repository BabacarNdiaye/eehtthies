# =============================================================================
# EEHT de Thiès — modèle de configuration
# =============================================================================
# Copiez ce fichier en `.env` pour un nouvel environnement de développement
# local (`cp .env.example .env`). Les valeurs ci-dessous sont adaptées au
# développement local.
#
# ⚠️  AVANT UNE MISE EN LIGNE RÉELLE (production), changez impérativement :
#   - APP_ENV=production
#   - APP_DEBUG=false   (sinon les erreurs affichent des détails techniques
#                         sensibles — requêtes SQL, chemins serveur — à tout
#                         visiteur du site)
#   - APP_URL=https://votre-domaine.sn
#   - DB_CONNECTION vers une vraie base (MySQL/PostgreSQL) si le volume de
#     données ou le nombre d'utilisateurs simultanés grandit au-delà de
#     SQLite
#   - MAIL_* avec vos vrais identifiants Brevo (ou autre fournisseur SMTP)
#   - Un vrai processus de file d'attente (`php artisan queue:work`, géré en
#     permanence par Supervisor ou équivalent) — sans lui, les e-mails
#     internes vers des destinataires externes ne partent jamais
#   - Une tâche cron serveur exécutant `php artisan schedule:run` chaque
#     minute — sans elle, les sauvegardes automatiques ne se déclenchent
#     jamais
# =============================================================================

APP_NAME="EEHT de Thiès"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# En local, MAIL_MAILER=log écrit les e-mails dans storage/logs/laravel.log
# au lieu de les envoyer réellement. Pour un vrai envoi (recommandé même en
# développement pour tester "mot de passe oublié"), utilisez par exemple
# Brevo : MAIL_MAILER=smtp, MAIL_HOST=smtp-relay.brevo.com, MAIL_PORT=587,
# MAIL_ENCRYPTION=tls, MAIL_USERNAME et MAIL_PASSWORD = vos identifiants SMTP.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@eeht-thies.sn"
MAIL_FROM_NAME="${APP_NAME}"

# Destinataire des alertes de sauvegarde (échec, anomalie détectée).
BACKUP_NOTIFY_EMAIL=admin@eeht-thies.sn
# Décommentez pour chiffrer les archives de sauvegarde (gardez ce mot de
# passe en lieu sûr : sans lui, les sauvegardes ne peuvent plus être ouvertes).
# BACKUP_ARCHIVE_PASSWORD=

# Notifications push (navigateur). Générées une fois en local via
# `php artisan webpush:vapid` — copiez les mêmes clés ici, ne les régénérez
# jamais en production (ça invaliderait les abonnements déjà enregistrés).
VAPID_SUBJECT=mailto:admin@eeht-thies.sn
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Jeton partagé par la tablette/borne de pointage à l'entrée
# (/borne/pointage/open?token=...&mode=gate). Générez une valeur aléatoire
# longue (ex : `php artisan tinker --execute="echo Str::random(32);"`).
KIOSK_TOKEN=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Assistant IA d'EEHT Connect (suggestions de réponses, résumés, correction,
# traduction). Laissez vide pour désactiver l'assistant. Clé à créer sur
# https://platform.claude.com (facturation à l'usage). Les extraits de
# conversation envoyés à l'assistant sont transmis à Anthropic.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_EFFORT=low

VITE_APP_NAME="${APP_NAME}"
